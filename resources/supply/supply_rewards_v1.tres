[gd_resource type="Resource" script_class="SupplyRewardTable" load_steps=9 format=3]

; PROVISIONAL: preserve aggregate coins 35%, boosts 30/20/15%; split coin share equally.
; Relative weights total 300. Final tier probabilities await the economy audit.

[ext_resource type="Script" path="res://scripts/meta/supply_reward_table.gd" id="1"]
[ext_resource type="Script" path="res://scripts/meta/supply_reward_entry.gd" id="2"]

[sub_resource type="Resource" id="coins"]
