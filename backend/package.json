{
  "name": "nospace-wallet-foundation",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:unit": "node --test dist/test/auth.test.js dist/test/catalog.test.js",
    "test:rules:run": "node --test dist/test/firestore-rules.test.js",
    "test:rules": "firebase emulators:exec --project demo-nospace-wallet --only firestore --config firebase.json \"npm run test:rules:run\"",
    "test": "npm run build && npm run test:unit && npm run test:rules"
  },
  "dependencies": {
    "firebase-admin": "14.5.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/node": "24.10.1",
    "firebase": "13.2.0",
    "firebase-tools": "15.34.2",
    "typescript": "5.9.3"
  }
}
